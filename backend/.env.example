TAOBAO_APP_KEY=replace_with_app_key
TAOBAO_APP_SECRET=replace_with_app_secret
TAOBAO_ADZONE_ID=replace_with_adzone_id
# 默认是关键词搜索。若使用 taobao.tbk.dg.material.recommend，需额外填写物料 ID。
# 当前项目使用推广者物料搜索升级版，支持 q 关键词和价格、类目等筛选。
TAOBAO_API_METHOD=taobao.tbk.dg.material.optional.upgrade
LLM_BASE_URL=https://myai.bupt.edu.cn/llm-gw/v1
LLM_API_KEY=replace_with_llm_api_key
LLM_MODEL=deepseek-v4-flash
PORT=3000
